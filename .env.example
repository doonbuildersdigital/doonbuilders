# Public site URL — used for canonical and Open Graph URLs (no trailing slash).
VITE_SITE_URL=

# Contact form provider: web3forms | formsubmit | netlify | custom
# Leave empty until a provider is chosen. The form validates but will not claim to send.
VITE_CONTACT_PROVIDER=

# Web3Forms access key (public key, safe for the browser) — when provider = web3forms
VITE_CONTACT_FORM_KEY=

# Endpoint URL — when provider = formsubmit (https://formsubmit.co/ajax/<email-or-token>) or custom
VITE_CONTACT_ENDPOINT=
